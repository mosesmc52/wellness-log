APP_TIMEZONE=America/New_York
TZ=America/New_York
APP_URL=http://localhost:8000

DATABASE_URL=sqlite:////app/data/wellness.db

# DigitalOcean Spaces SQLite backup and restore.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3
# Optional; defaults to https://<region>.digitaloceanspaces.com.
SPACES_ENDPOINT=
# Optional CDN base URL used only when displaying the uploaded object URL.
SPACES_CDN_BASE=
SPACES_DB_KEY=db/wellness.db
SPACES_DB_PATH=/app/data/wellness.db
# Each upload preserves the previous object under this prefix.
SPACES_BACKUP_PREFIX=backups
# Maximum number of historical objects to retain.
SPACES_BACKUP_RETENTION=3

AWS_SES_REGION_NAME=us-east-1
# Leave credentials blank when using an IAM role or another AWS credential provider.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_SESSION_TOKEN=

FROM_ADDRESS=
# Separate multiple recipients with commas.
TO_ADDRESSES=
